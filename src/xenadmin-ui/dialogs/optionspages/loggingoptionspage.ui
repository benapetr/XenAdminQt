       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QComboBox" name="LevelComboBox">
       <property name="toolTip">
        <string>Debug messages make the log much larger and are written to disk more often. Turn them on only while investigating a problem.</string>

<ui version="4.0">
 <class>NewVMApplianceWizard</class>
 <widget class="QWizard" name="NewVMApplianceWizard">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>820</width>
    <height>560</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>New vApp</string>
  </property>
  <widget class="QWizardPage" name="pageName">
   <property name="title">
    <string>What do you want to call this vApp?</string>
   </property>
   <layout class="QVBoxLayout" name="nameLayout">
    <item>
     <widget class="QLabel" name="labelWizard">
      <property name="text">
       <string>Use this wizard to define a vApp that will allow you to easily recover your critical VMs and services on a secondary site in the event of the loss of your primary production site.

To begin, enter a name for the vApp and a description (optional), then click Next.</string>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <layout class="QFormLayout" name="nameForm">
      <item row="0" column="0">
       <widget class="QLabel" name="labelName">
        <property name="text">
         <string>Na&amp;me:</string>
        </property>
        <property name="buddy">
         <cstring>textName</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="textName"/>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="labelDescription">
        <property name="text">
         <string>&amp;Description:</string>
        </property>
        <property name="buddy">
         <cstring>textDescription</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QPlainTextEdit" name="textDescription">
        <property name="tabChangesFocus">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
  <widget class="QWizardPage" name="pageVMs">
   <property name="title">
    <string>Choose which VMs to include in this vApp</string>
   </property>
   <layout class="QVBoxLayout" name="vmsLayout">
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
   </layout>
  </widget>
  <widget class="QWizardPage" name="pageOrder">
   <property name="title">
    <string>Configure the startup sequence for the VMs in this vApp</string>
   </property>
   <layout class="QVBoxLayout" name="orderLayout">
    <property name="leftMargin">
     <number>0</number>
    </property>
    <property name="topMargin">
     <number>0</number>
    </property>
    <property name="rightMargin">
     <number>0</number>
    </property>
    <property name="bottomMargin">
     <number>0</number>
    </property>
   </layout>
  </widget>
  <widget class="QWizardPage" name="pageFinish">
   <property name="title">
    <string>Create the new vApp</string>
   </property>
   <layout class="QVBoxLayout" name="finishLayout">
    <item>
     <widget class="QLabel" name="labelFinish">
      <property name="text">
       <string>Review the new vApp below and click Previous if you want to change any settings or Finish to create the new vApp.</string>
      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QPlainTextEdit" name="textSummary">
      <property name="readOnly">
       <bool>true</bool>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>

   </rect>
  </property>
  <property name="windowTitle">
   <string>Attach USB</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QLabel" name="labelNote">
     <property name="text">
      <string>Select a device to be passed through to this virtual machine.</string>
     </property>

    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="warningLayout">
     <item alignment="Qt::AlignTop">
      <widget class="QLabel" name="pictureBoxAlert">
       <property name="pixmap">
        <pixmap resource="../resources.qrc">:/icons/alert_16.png</pixmap>
